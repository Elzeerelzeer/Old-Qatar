const PHOTO_WIDTH = 1400;
const PHOTO_HEIGHT = 900;

function clamp(
  value: number,
  min: number,
  max: number
) {
  return Math.min(
    max,
    Math.max(
      min,
      value
    )
  );
}

function loadImage(
  src: string
) {
  return new Promise<
    HTMLImageElement | null
  >(
    resolve => {
      const image =
        new Image();

      image.onload =
        () =>
          resolve(
            image
          );

      image.onerror =
        () =>
          resolve(
            null
          );

      image.src =
        src;
    }
  );
}

function drawCover(
  ctx:
    CanvasRenderingContext2D,
  source:
    CanvasImageSource,
  sourceWidth:
    number,
  sourceHeight:
    number,
  x: number,
  y: number,
  width: number,
  height: number,
  zoom = 1,
  offsetX = 0,
  offsetY = 0
) {
  const scaledWidth =
    sourceWidth /
    zoom;

  const scaledHeight =
    sourceHeight /
    zoom;

  const targetRatio =
    width /
    height;

  let cropWidth =
    scaledWidth;

  let cropHeight =
    scaledHeight;

  if (
    cropWidth /
      cropHeight >
    targetRatio
  ) {
    cropWidth =
      cropHeight *
      targetRatio;
  } else {
    cropHeight =
      cropWidth /
      targetRatio;
  }

  const maxX =
    Math.max(
      0,
      sourceWidth -
        cropWidth
    );

  const maxY =
    Math.max(
      0,
      sourceHeight -
        cropHeight
    );

  const normalizedX =
    clamp(
      0.5 -
        offsetX /
          100,
      0,
      1
    );

  const normalizedY =
    clamp(
      0.35 -
        offsetY /
          100,
      0,
      1
    );

  const sx =
    maxX *
    normalizedX;

  const sy =
    maxY *
    normalizedY;

  ctx.drawImage(
    source,
    sx,
    sy,
    cropWidth,
    cropHeight,
    x,
    y,
    width,
    height
  );
}

function drawSceneCover(
  ctx:
    CanvasRenderingContext2D,
  image:
    HTMLImageElement
) {
  const sourceRatio =
    image.naturalWidth /
    image.naturalHeight;

  const targetRatio =
    PHOTO_WIDTH /
    PHOTO_HEIGHT;

  let sx = 0;
  let sy = 0;
  let sw =
    image.naturalWidth;

  let sh =
    image.naturalHeight;

  if (
    sourceRatio >
    targetRatio
  ) {
    sw =
      image.naturalHeight *
      targetRatio;

    sx =
      (
        image.naturalWidth -
        sw
      ) /
      2;
  } else {
    sh =
      image.naturalWidth /
      targetRatio;

    sy =
      (
        image.naturalHeight -
        sh
      ) /
      2;
  }

  ctx.drawImage(
    image,
    sx,
    sy,
    sw,
    sh,
    0,
    0,
    PHOTO_WIDTH,
    PHOTO_HEIGHT
  );
}

export function AkkasScene({
  gender,
  settings,
  studentName = '',
  onReturnToVillage,
  onComplete,
}: AkkasSceneProps) {
  const [
    step,
    setStep,
  ] =
    useState<Step>(
      'welcome'
    );

  const [
    selectedScene,
    setSelectedScene,
  ] =
    useState<SceneId>(
      'souq'
    );

  const [
    cameraError,
    setCameraError,
  ] =
    useState<string | null>(
      null
    );

  const [
    isCameraReady,
    setIsCameraReady,
  ] =
    useState(false);

  const [
    uploadedUrl,
    setUploadedUrl,
  ] =
    useState<string | null>(
      null
    );

  const [
    capturedUrl,
    setCapturedUrl,
  ] =
    useState<string | null>(
      null
    );

  /*
    These controls only move/zoom the visitor INSIDE the predefined photo slot.
    The slot itself stays fixed for every activity background.
  */
  const [
    imageZoom,
    setImageZoom,
  ] =
    useState(1.15);

  const [
    imageOffsetX,
    setImageOffsetX,
  ] =
    useState(0);

  const [
    imageOffsetY,
    setImageOffsetY,
  ] =
    useState(0);

  const [
    isComposing,
    setIsComposing,
  ] =
    useState(false);

  const streamRef =
    useRef<MediaStream | null>(
      null
    );

  const videoRef =
    useRef<HTMLVideoElement | null>(
      null
    );

  const uploadedImageRef =
    useRef<HTMLImageElement | null>(
      null
    );

  const canvasRef =
    useRef<HTMLCanvasElement | null>(
      null
    );

  const completedRef =
    useRef(false);

  const currentScene =
    useMemo(
      () =>
        SCENES.find(
          item =>
            item.id ===
            selectedScene
        ) ??
        SCENES[0],
      [selectedScene]
    );

  const visitorLabel =
    gender === 'boy'
      ? 'المنتسب'
      : 'المنتسبة';

  const visitorName =
    studentName.trim() ||
    (
      gender === 'boy'
        ? 'منتسب قطر لوّل'
        : 'منتسبة قطر لوّل'
    );

  const stopCamera =
    () => {
      streamRef.current
        ?.getTracks()
        .forEach(
          track =>
            track.stop()
        );

      streamRef.current =
        null;

      setIsCameraReady(
        false
      );
    };

  const speak = (
    text: string
  ) => {
    if (
      !settings.isSoundEnabled ||
      typeof window ===
        'undefined' ||
      !(
        'speechSynthesis' in
        window
      )
    ) {
      return;
    }

    const utterance =
      new SpeechSynthesisUtterance(
        text
      );

    utterance.lang =
      'ar-QA';

    utterance.rate =
      0.9;

    utterance.volume =
      Math.max(
        0.2,
        Math.min(
          1,
          settings.volume ??
            0.6
        )
      );

    window
      .speechSynthesis
      .cancel();

    window
      .speechSynthesis
      .speak(
        utterance
      );
  };

  const startCamera =
    async () => {
      setCameraError(
        null
      );

      stopCamera();

      if (
        !navigator
          .mediaDevices
          ?.getUserMedia
      ) {
        setCameraError(
          'الكاميرا غير متاحة. يمكنك اختيار صورة من الجهاز.'
        );

        return;
      }

      try {
        const stream =
          await navigator
            .mediaDevices
            .getUserMedia({
              video: {
                facingMode:
                  'user',
                width: {
                  ideal: 1280,
                },
                height: {
                  ideal: 960,
                },
              },
              audio: false,
            });

        streamRef.current =
          stream;

        if (
          videoRef.current
        ) {
          videoRef.current.srcObject =
            stream;

          await videoRef.current
            .play()
            .catch(
              () =>
                undefined
            );
        }

        setIsCameraReady(
          true
        );

        speak(
          gender === 'boy'
