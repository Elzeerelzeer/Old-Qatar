from pathlib import Path
import re, shutil

src = Path("/mnt/data/AkkasScene.tsx")
text = src.read_text(encoding="utf-8")

# 1) More aggressive top-biased face crop for final canvas.
text = text.replace(
"""  const normalizedX = clamp(0.5 - offsetX / 100, 0, 1);
  const normalizedY = clamp(0.5 - offsetY / 100, 0, 1);""",
"""  const normalizedX = clamp(0.5 - offsetX / 100, 0, 1);

  // The face is normally in the upper part of a selfie frame.
  // Start the crop near the top instead of the vertical center,
  // otherwise a chest/shirt can appear inside the face opening.
  const normalizedY = clamp(0.04 - offsetY / 100, 0, 1);"""
)

# 2) Default zoom: crop upper body much tighter around head/face.
text = text.replace(
"  const [faceZoom, setFaceZoom] = useState(1.15);",
"  const [faceZoom, setFaceZoom] = useState(1.95);"
)
text = text.replace(
"  const [faceOffsetY, setFaceOffsetY] = useState(-2);",
"  const [faceOffsetY, setFaceOffsetY] = useState(0);"
)

# 3) Reset values.
text = text.replace(
"""  const resetFace = () => {
    setFaceZoom(1.15);
    setFaceOffsetX(0);
    setFaceOffsetY(-2);
  };""",
"""  const resetFace = () => {
    // Head-first default: top-centred crop with enough zoom
    // to keep the current shirt/body outside the face window.
    setFaceZoom(1.95);
    setFaceOffsetX(0);
    setFaceOffsetY(0);
  };"""
)

# 4) Canvas final output: draw outfit FIRST, then face on top.
old_canvas = """      ctx.save();
      ctx.beginPath();
      ctx.ellipse(faceCx, faceCy, faceW / 2, faceH / 2, 0, 0, Math.PI * 2);
      ctx.clip();

      // The live camera is mirrored in preview, so mirror it in the final image too.
      if (!uploadedImageUrl && source === videoRef.current) {
        ctx.translate(faceX + faceW, faceY);
        ctx.scale(-1, 1);
        drawCoverCrop(
          ctx,
          source,
          sourceWidth,
          sourceHeight,
          0,
          0,
          faceW,
          faceH,
          faceZoom,
          faceOffsetX,
          faceOffsetY,
        );
      } else {
        drawCoverCrop(
          ctx,
          source,
          sourceWidth,
          sourceHeight,
          faceX,
          faceY,
          faceW,
          faceH,
          faceZoom,
          faceOffsetX,
          faceOffsetY,
        );
      }
      ctx.restore();

      drawOutfitCanvas(ctx, currentLook.id, faceCx, faceCy, faceW, faceH);"""

new_canvas = """      // Draw the outfit first. The face is drawn afterwards so
      // clothing/head-dress shapes can never cover the visitor's face.
      drawOutfitCanvas(ctx, currentLook.id, faceCx, faceCy, faceW, faceH);

      ctx.save();
      ctx.beginPath();
      ctx.ellipse(faceCx, faceCy, faceW / 2, faceH / 2, 0, 0, Math.PI * 2);
      ctx.clip();

      // The live camera is mirrored in preview, so mirror it in the final image too.
      if (!uploadedImageUrl && source === videoRef.current) {
        ctx.translate(faceX + faceW, faceY);
        ctx.scale(-1, 1);
        drawCoverCrop(
          ctx,
          source,
          sourceWidth,
          sourceHeight,
          0,
          0,
          faceW,
          faceH,
          faceZoom,
          faceOffsetX,
          faceOffsetY,
        );
      } else {
        drawCoverCrop(
          ctx,
          source,
          sourceWidth,
          sourceHeight,
          faceX,
          faceY,
          faceW,
          faceH,
          faceZoom,
          faceOffsetX,
          faceOffsetY,
        );
      }
      ctx.restore();

      // Clear visual edge around the real face.
      ctx.beginPath();
      ctx.ellipse(faceCx, faceCy, faceW / 2, faceH / 2, 0, 0, Math.PI * 2);
      ctx.lineWidth = 6;
      ctx.strokeStyle = currentTheme.accentColor;
      ctx.stroke();"""

if old_canvas not in text:
    raise RuntimeError("Canvas block not found")
text = text.replace(old_canvas, new_canvas, 1)

# 5) Preview transform: top-anchored zoom instead of centered translate/scale.
old_transform = """  const faceTransform = `${uploadedImageUrl ? '' : 'scaleX(-1) '}translate(${faceOffsetX}%, ${faceOffsetY}%) scale(${faceZoom})`;"""
new_transform = """  // Preview crop is anchored to the TOP of the source image.
  // This is the key fix for webcams where the old centered crop showed the shirt/chest.
  const faceObjectPosition = `${clamp(50 - faceOffsetX, 8, 92)}% ${clamp(
    3 - faceOffsetY,
    0,
    35,
  )}%`;

  const faceTransform = uploadedImageUrl
    ? `scale(${faceZoom})`
    : `scaleX(-1) scale(${faceZoom})`;"""
if old_transform not in text:
    raise RuntimeError("faceTransform line not found")
text = text.replace(old_transform, new_transform, 1)

# 6) Preview: outfit first, face second with higher z-index, and top-centered object position.
old_preview = """                {/* FACE ONLY: current shirt/clothes can no longer fill the scene. */}
                <div className="absolute z-10 left-1/2 top-[11%] -translate-x-1/2 w-[24%] h-[31%] rounded-[45%] overflow-hidden bg-black border-[3px] border-[#FFE082] shadow-2xl">
                  {!uploadedImageUrl ? (
                    <video
                      ref={videoRef}
                      autoPlay
                      muted
                      playsInline
                      className="absolute inset-0 w-full h-full object-cover"
                      style={{ transform: faceTransform, transformOrigin: 'center' }}
                    />
                  ) : (
                    <img
                      ref={uploadedImageRef}
                      src={uploadedImageUrl}
                      alt="الصورة المختارة"
                      className="absolute inset-0 w-full h-full object-cover"
                      style={{ transform: faceTransform, transformOrigin: 'center' }}
                    />
                  )}
                </div>

                <OutfitPreview look={currentLook.id} />"""

new_preview = """                {/* Outfit sits BEHIND the real face. */}
                <div className="absolute inset-0 z-10 pointer-events-none">
                  <OutfitPreview look={currentLook.id} />
                </div>

                {/* REAL FACE WINDOW
                    Important: this is rendered AFTER the outfit and with a higher z-index.
                    The crop is top-anchored so the head appears instead of the shirt/chest. */}
                <div className="absolute z-20 left-1/2 top-[9%] -translate-x-1/2 w-[27%] min-w-[145px] max-w-[245px] h-[35%] min-h-[160px] max-h-[245px] rounded-[46%] overflow-hidden bg-[#111] border-[3px] border-[#FFE082] shadow-[0_8px_24px_rgba(0,0,0,.55)]">
                  {!uploadedImageUrl ? (
                    <video
                      ref={videoRef}
                      autoPlay
                      muted
                      playsInline
                      className="absolute inset-0 w-full h-full object-cover"
                      style={{
                        objectPosition: faceObjectPosition,
                        transform: faceTransform,
                        transformOrigin: '50% 0%',
                      }}
                    />
                  ) : (
                    <img
                      ref={uploadedImageRef}
                      src={uploadedImageUrl}
                      alt="الصورة المختارة"
                      className="absolute inset-0 w-full h-full object-cover"
                      style={{
                        objectPosition: faceObjectPosition,
                        transform: faceTransform,
                        transformOrigin: '50% 0%',
                      }}
                    />
                  )}

                  {/* Face centre guide only; never blocks the face. */}
                  <div className="absolute inset-[8%] rounded-[46%] border border-dashed border-white/35 pointer-events-none" />
                </div>"""

if old_preview not in text:
    raise RuntimeError("Preview face block not found")
text = text.replace(old_preview, new_preview, 1)

# 7) Fix helper text and zoom bounds: allow useful tighter face crop.
text = text.replace(
"""                  {isCameraReady || uploadedImageUrl
                    ? 'اجعل الوجه فقط داخل الدائرة — اللبس سيغطي الجسم بالكامل'
                    : 'جاري فتح الكاميرا…'}""",
"""                  {isCameraReady || uploadedImageUrl
                    ? 'الوجه يجب أن يظهر داخل الإطار الذهبي — استخدم الأسهم إذا احتاج ضبطًا'
                    : 'جاري فتح الكاميرا…'}"""
)

text = text.replace(
"clamp(value - 0.08, 1, 2)",
"clamp(value - 0.1, 1.25, 2.8)"
)
text = text.replace(
"clamp(value + 0.08, 1, 2)",
"clamp(value + 0.1, 1.25, 2.8)"
)

# 8) Clearer control instructions.
text = text.replace(
"استخدم الأسهم إذا كان الوجه أعلى أو أسفل من الفتحة.",
"الافتراضي يلتقط أعلى الصورة لإظهار الرأس. استخدم الأسهم لضبط الوجه بدقة."
)

# 9) Save new file
out = Path("/mnt/data/AkkasScene_head_fixed.tsx")
out.write_text(text, encoding="utf-8")

# Replace convenient current AkkasScene too.
shutil.copyfile(out, Path("/mnt/data/AkkasScene.tsx"))

print("Created:", out)
print("Updated:", Path("/mnt/data/AkkasScene.tsx"))
print("Size:", out.stat().st_size)
